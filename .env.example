# ==============================================================================
# PSP Relay Environment Configuration Template
# Copy to .env and fill in environment-specific credentials before deploying.
# ==============================================================================

# HTTP Server & Docker Host Port Binding
APP_BIND_IP=127.0.0.1
APP_PORT=8083
ADDR=:8083
ENVIRONMENT=production
LOG_LEVEL=info

# Product Routing YAML Configuration
# Host path mounted read-only into /app/config.yaml inside the container.
CONFIG_HOST_PATH=./config.prod.yaml
CONFIG_FILE_PATH=/app/config.yaml

# PostgreSQL Database
POSTGRES_USER=psprelay
POSTGRES_PASSWORD=change_me
POSTGRES_DB=psprelay
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PORT=5435
# Must match POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB above.
DATABASE_URL=postgres://psprelay:change_me@postgres:5432/psprelay?sslmode=disable

# Kafka (shared external broker container, e.g. crosspay_kafka on docker_default)
KAFKA_EXTERNAL_NETWORK=docker_default
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=psp.webhooks
KAFKA_DLQ_TOPIC=psp.webhooks.dlq
KAFKA_CONSUMER_GROUP=psprelay-dispatcher

# Payment Service Provider Webhook Verification Secrets
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
MONNIFY_SECRET_KEY=

# Admin Management UI & API Basic Auth (mandatory when ENVIRONMENT=production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# Background Worker Intervals
OUTBOX_POLL_INTERVAL=5s
RETRY_POLL_INTERVAL=2s
RETRY_BASE_BACKOFF=5s
